{
  "name": "progenitor-node-video",
  "version": "1.0.0",
  "private": true,
  "description": "YouTube-style explainer for the Progenitor Node Model, generated with Remotion",
  "scripts": {
    "data": "python scripts/export_data.py",
    "voice": "node scripts/voice.mjs",
    "music": "python scripts/music.py",
    "prep": "npm run data && npm run voice && npm run music",
    "studio": "remotion studio",
    "render": "node scripts/render.mjs full en",
    "render:full:fr": "node scripts/render.mjs full fr",
    "i18n:check": "node scripts/i18n-check.mjs",
    "thumbnail": "remotion still Thumbnail out/thumbnail.png",
    "stills": "node scripts/stills.mjs",
    "frames": "node scripts/frames.mjs",
    "typecheck": "tsc --noEmit",
    "i18n:review": "node scripts/i18n-review.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "katex": "0.16.22",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
